@inject BlazorGame.Client.Services.PlayerState PlayerState

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BlazorGame.Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
       
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="nouvelle-aventure">
                <span class="bi bi-map-nav-menu" aria-hidden="true"></span> Nouvelle Aventure
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="joueurs">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Joueurs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="classement">
                <span class="bi bi-trophy-nav-menu" aria-hidden="true"></span> Classement
            </NavLink>
        </div>  
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Admin
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/partie-en-cours" Match="NavLinkMatch.All">
                <span class="bi bi-play-fill" aria-hidden="true"></span> Partie en cours
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/historique-parties">
                <span class="bi bi-archive-fill" aria-hidden="true"></span> Historique
            </NavLink>
        </div>
        <div class="nav-item px-3 mt-2">
            @if (PlayerState.CurrentJoueurId is not null && PlayerState.CurrentJoueurId != Guid.Empty)
            {
                <div class="alert alert-success p-2 mb-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <span>Joueur : <strong>@PlayerState.CurrentJoueurNom</strong></span>
                        <NavLink class="btn btn-sm btn-light ms-2" href="joueurs">Changer</NavLink>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning p-2 mb-0 d-flex align-items-center justify-content-between">
                    <span>Aucun joueur sélectionné</span>
                    <NavLink class="btn btn-sm btn-light ms-2" href="joueurs">Choisir</NavLink>
                </div>
            }
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
