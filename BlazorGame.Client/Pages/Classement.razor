@page "/classement"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Classement</PageTitle>

<div class="container mt-4">
    <h1>Classement des joueurs</h1>

    @if (isLoading)
    {
        <p>Chargement...</p>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-warning">@message</div>
    }
    else if (!joueurs.Any())
    {
        <div class="alert alert-info">Aucun joueur enregistré.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nom</th>
                    <th>Score total</th>
                    <th>Parties</th>
                    <th>Dernière connexion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tuple in joueurs.Select((j, i) => (Index: i + 1, Joueur: j)))
                {
                    <tr>
                        <td>@tuple.Index</td>
                        <td>@tuple.Joueur.Nom</td>
                        <td>@tuple.Joueur.ScoreTotal</td>
                        <td>@tuple.Joueur.PartiesTerminees</td>
                        <td>@tuple.Joueur.DerniereConnexion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<ClassementEntry> joueurs = new();
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var data = await Http.GetFromJsonAsync<List<ClassementEntry>>("api/Joueurs/classement");
            joueurs = data ?? new();
        }
        catch (Exception ex)
        {
            message = $"Erreur chargement classement : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

public class ClassementEntry
{
    public Guid Id { get; set; }
    public string Nom { get; set; } = string.Empty;
    public string Mail { get; set; } = string.Empty;
    public int ScoreTotal { get; set; }
    public int PartiesTerminees { get; set; }
    public DateTime DerniereConnexion { get; set; }
}
