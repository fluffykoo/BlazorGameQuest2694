@page "/nouvelle-aventure"
@using BlazorGame.Domain
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject IHttpClientFactory ClientFactory
@inject IJSRuntime JS
@inject BlazorGame.Client.Services.PlayerState PlayerState
@using System.Linq
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<PageTitle>Nouvelle Aventure</PageTitle>

<div class="simple-adventure-page">
    <div class="adventure-header">
        <h1>🚀 Nouvelle Aventure</h1>
        <p>Choisissez votre destinée</p>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner">⚔️</div>
            <p>Génération du donjon en cours...</p>
        </div>
    }
    else
    {
        <div class="adventure-options">
            <div class="option-card primary-card">
                <div class="option-icon">🎮</div>
                <h3>Commencer l'Aventure</h3>
                <p>Démarrez directement dans le donjon généré aléatoirement et affrontez vos ennemis.</p>
                <button class="btn-option" @onclick="CommencerAventure">
    Commencer une nouvelle aventure
</button>
            </div>

            <div class="option-card">
                <div class="option-icon">📚</div>
                <h3>Guide du Débutant</h3>
                <p>Apprenez les règles du combat, les risques de la fuite et les gains de l'exploration.</p>
                <button class="btn-option btn-secondary" @onclick="VoirTutoriel">
                    Lire les Règles
                </button>
            </div>

            <div class="option-card">
                <div class="option-icon">⚙️</div>
                <h3>Paramètres</h3>
                <p>Configurez les options de jeu et la difficulté.</p>
                <button class="btn-option btn-secondary" @onclick="OuvrirParametres">
                    Ouvrir les paramètres
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(MessageStatut))
    {
        <div class="status-message">
            @MessageStatut
        </div>
    }
</div>

@code {
    private string MessageStatut = "";
    private bool isLoading = false;

    private async Task CommencerAventure()
    {
        if (PlayerState.CurrentJoueurId is null || PlayerState.CurrentJoueurId == Guid.Empty)
        {
            Navigation.NavigateTo("/joueurs");
            return;
        }

        isLoading = true;
        MessageStatut = "";

        try
        {
            var api = ClientFactory.CreateClient("Api");
            var response = await api.PostAsync(
                $"api/Partie/demarrer?joueurId={PlayerState.CurrentJoueurId}",
                content: null);

            if (response.IsSuccessStatusCode)
            {
                var partie = await response.Content.ReadFromJsonAsync<Partie>();

                if (partie != null)
                {
                    // Redirection directe vers la page Donjon
                    Navigation.NavigateTo($"/donjon/{partie.Id}");
                    return;
                }
                else
                {
                    MessageStatut = "La partie générée est vide. Vérifiez la réponse de l'API.";
                }
            }
            else
            {
                MessageStatut = "Erreur lors de la création du donjon. Veuillez réessayer.";
            }
        }
        catch (AccessTokenNotAvailableException tokenEx)
        {
            tokenEx.Redirect();
        }
        catch (Exception ex)
        {
            MessageStatut = $"Erreur de connexion : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void VoirTutoriel()
    {
        Navigation.NavigateTo("/regles");
    }

    private void OuvrirParametres()
    {
        MessageStatut = "⚙️ Les paramètres seront disponibles dans une future mise à jour.";
    }
}

<style>
    .simple-adventure-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .adventure-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .adventure-header h1 {
        color: #ffd700;
        font-size: 3rem;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
        font-family: 'MedievalSharp', cursive;
    }

    .adventure-header p {
        color: #e0d0b0;
        font-size: 1.3rem;
        margin: 0;
    }

    .adventure-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        width: 100%;
        margin-bottom: 2rem;
    }

    .option-card {
        background: linear-gradient(rgba(40, 25, 15, 0.9), rgba(30, 15, 5, 0.95));
        padding: 2rem;
        border-radius: 15px;
        border: 1px solid #8b4513;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Mise en valeur de la carte principale */
    .primary-card {
        border: 2px solid #d4af37;
        transform: scale(1.02);
        background: linear-gradient(rgba(60, 40, 20, 0.9), rgba(40, 20, 10, 0.95));
    }

    .option-card:hover {
        transform: translateY(-5px) scale(1.03);
        border-color: #ffd700;
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.2);
    }

    .option-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        display: block;
    }

    .option-card h3 {
        color: #ffd700;
        margin-bottom: 1rem;
        font-size: 1.5rem;
        font-family: 'MedievalSharp', cursive;
    }

    .option-card p {
        color: #e0d0b0;
        margin-bottom: 2rem;
        line-height: 1.6;
        font-size: 1rem;
    }

    .btn-option {
        width: 100%;
        padding: 0.8rem 1.5rem;
        background: linear-gradient(135deg, #d4af37, #b8860b);
        color: #1a0f0f;
        border: none;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        font-family: 'MedievalSharp', cursive;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-option:hover {
        background: linear-gradient(135deg, #ffd700, #d4af37);
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
    }

    .btn-secondary {
        background: transparent;
        color: #d4af37;
        border: 2px solid #d4af37;
    }

    .btn-secondary:hover {
        background: rgba(212, 175, 55, 0.1);
        color: #fff;
        box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
    }

    .status-message {
        background: rgba(220, 38, 38, 0.2);
        border: 1px solid #ef4444;
        color: #fca5a5;
        padding: 1rem 2rem;
        border-radius: 8px;
        text-align: center;
        margin-top: 2rem;
        font-weight: bold;
        animation: fadeIn 0.5s ease-in;
    }

    /* Animation de chargement */
    .loading-container {
        text-align: center;
        margin: 3rem 0;
    }

    .spinner {
        font-size: 4rem;
        display: inline-block;
        animation: spin 2s infinite linear;
        margin-bottom: 1rem;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@media (max-width: 768px) {
        .adventure-header h1 { font-size: 2rem; }
        .adventure-options { grid-template-columns: 1fr; }
    }
</style>
