@page "/historique-parties"
@using BlazorGame.Domain
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BlazorGame.Client.Services.PlayerState PlayerState

<h1>Historique des parties</h1>

@if (parties == null)
{
    <p>Chargement...</p>
}
else if (!parties.Any())
{
    <p>Aucune partie trouvée pour ce joueur.</p>
}
else
{
    <table class="table table-dark table-striped table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Donjon</th>
                <th>Score final</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in parties)
        {
            <tr>
                <td>@p.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@p.Donjon?.Nom</td>
                <td>@p.ScoreFinal pts</td>
                <td>@(p.EstTerminee ? "Terminée" : "En cours")</td>
                <td>
                    <button class="btn btn-sm btn-outline-warning me-2"
                            @onclick="() => OuvrirHistorique(p.Id)">
                        Détails
                    </button>

                    @if (!p.EstTerminee)
                    {
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => ReprendrePartie(p.Id)">
                            Reprendre
                        </button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<Partie>? parties;

    protected override async Task OnInitializedAsync()
    {
        if (PlayerState.CurrentJoueurId is null || PlayerState.CurrentJoueurId == Guid.Empty)
        {
            Navigation.NavigateTo("/joueurs");
            return;
        }

        parties = await Http.GetFromJsonAsync<List<Partie>>(
            $"api/Partie/joueur/{PlayerState.CurrentJoueurId}");
    }

    private void OuvrirHistorique(Guid partieId)
        => Navigation.NavigateTo($"/historique/{partieId}");

    private void ReprendrePartie(Guid partieId)
        => Navigation.NavigateTo($"/donjon/{partieId}");
}
