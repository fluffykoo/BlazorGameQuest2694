@page "/admin"
@using System.Net.Http.Json
@using BlazorGame.Client.Models
@inject HttpClient Http

<PageTitle>Admin</PageTitle>

<div class="container mt-4">
    <h1>Administration</h1>
    <p class="text-muted">Vue rapide sur les joueurs, scores et actions admin.</p>

    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-primary btn-sm" @onclick="Charger">
            <span class="bi bi-arrow-clockwise"></span> Rafraîchir
        </button>
        <a class="btn btn-outline-secondary btn-sm" href="@exportUrl" download="joueurs.json">
            <span class="bi bi-download"></span> Export JSON
        </a>
    </div>

    @if (isLoading)
    {
        <p>Chargement...</p>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-warning">@message</div>
    }
    else
    {
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Score</th>
                    <th>Parties</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in joueurs)
                {
                    <tr>
                        <td>@j.Nom</td>
                        <td>@j.Mail</td>
                        <td>@j.ScoreTotal</td>
                        <td>@j.PartiesTerminees</td>
                        <td>
                            @if (j.EstActif)
                            {
                                <span class="badge bg-success">Actif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Désactivé</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-warning btn-sm" @onclick="() => Toggle(j.Id)">
                                @(j.EstActif ? "Désactiver" : "Activer")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<AdminJoueurDto> joueurs = new();
    private bool isLoading = true;
    private string? message;
    private string exportUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        exportUrl = new Uri(Http.BaseAddress, "api/Joueurs/export").ToString();
        await Charger();
    }

    private async Task Charger()
    {
        try
        {
            isLoading = true;
            var data = await Http.GetFromJsonAsync<List<AdminJoueurDto>>("api/Joueurs/classement-admin");
            joueurs = data ?? new();
        }
        catch (Exception ex)
        {
            message = $"Erreur chargement joueurs : {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Toggle(Guid id)
    {
        try
        {
            var response = await Http.PatchAsync($"api/Joueurs/{id}/toggle", null);
            response.EnsureSuccessStatusCode();
            await Charger();
        }
        catch (Exception ex)
        {
            message = $"Impossible de changer le statut : {ex.Message}";
        }
    }
}
