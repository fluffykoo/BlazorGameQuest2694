@page "/donjon/{partieId:guid}"
@using BlazorGame.Domain
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<h1>@donjon?.Nom</h1>
<p>@donjon?.Description</p>

@if (partieTerminee)
{
    <div class="alert alert-danger">
        Partie terminée : vous êtes mort ou avez fini l’aventure. Lance une nouvelle aventure ou consulte ton score.
    </div>
}

@if (partie is not null)
{
    <a class="btn btn-outline-warning"
       href="@($"/historique/{partie.Id}")">
        Voir l'historique de la partie
    </a>
}

@if (scoreMax > 0)
{
    <section class="dungeon-score">
        <h4>Score de la partie</h4>
        @{
            double progress = (double)scoreTotal / scoreMax * 100;
            if (progress < 0) progress = 0;
            if (progress > 100) progress = 100;
        }
        <div class="score-bar">
            <div class="score-fill" style="width:@progress%"></div>
        </div>
        <span class="score-text">@scoreTotal pts</span>
    </section>
}

@if (salles is null)
{
    <p>Chargement...</p>
}
else 
{
    <section class="dungeon-map-wrapper">
        <h3>Plan du donjon</h3>

        <div class="dungeon-map">
            @foreach (var salle in salles.OrderBy(s => s.Position))
            {
                bool isUnlocked = salle.EstVisitee || salle.Position == prochaineSalle;
                string doorImage = isUnlocked
                    ? "images/salles/porte_ouverte.png"
                    : "images/salles/porte_fermee.png";

                <button class="room-node @(isUnlocked ? "room-unlocked" : "room-locked")"
                        disabled="@(!isUnlocked || partieTerminee)"
                        @onclick="() => OuvrirSalle(salle)">
                    
                    <div class="room-node-inner">
                        <img src="@doorImage" alt="Porte salle @salle.Position" class="room-icon" />
                    </div>

                    <div class="room-label">Salle @salle.Position</div>
                    <div class="room-level">@salle.Niveau</div>
                </button>
            }
        </div>
    </section>
}

@code {
    [Parameter] public Guid partieId { get; set; }

    private Partie? partie;
    private Donjon? donjon;
    private List<Salle>? salles;
    private int prochaineSalle;
    private int scoreTotal;
    private int scoreMax;
    private bool partieTerminee;

    protected override async Task OnInitializedAsync()
    {
        // On récupère la partie complète depuis l’API
        partie = await Http.GetFromJsonAsync<Partie>($"api/Partie/{partieId}");
        if (partie is null) return;

        donjon = partie.Donjon;
        salles = partie.Salles?.OrderBy(s => s.Position).ToList() ?? new List<Salle>();
        partieTerminee = partie.EstTerminee;

        // Score actuel
        scoreTotal = partie.ScoreFinal;

        // Estimation d’un score max : 100 pts max par salle
        var nbSalles = partie.Salles?.Count ?? 0;
        scoreMax = nbSalles > 0 ? nbSalles * 100 : 100;

        // Prochaine salle non visitée
        prochaineSalle = salles
            .Where(s => !s.EstVisitee)
            .OrderBy(s => s.Position)
            .Select(s => s.Position)
            .DefaultIfEmpty(1)
            .First();
    }

    private void OuvrirSalle(Salle salle)
    {
        if (partieTerminee)
        {
            Navigation.NavigateTo($"/score/{partieId}");
            return;
        }
        Navigation.NavigateTo($"/salle/{partieId}");
    }
}
