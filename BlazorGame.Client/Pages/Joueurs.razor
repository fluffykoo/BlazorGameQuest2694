@page "/joueurs"
@using BlazorGame.Domain
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject BlazorGame.Client.Services.PlayerState PlayerState
@attribute [Authorize]
@inherits OwningComponentBase

<PageTitle>Joueur connecté</PageTitle>

<div class="container mt-4">
    <h2>Joueur connecté</h2>

    @if (loading)
    {
        <p>Chargement / association du joueur...</p>
    }
    else if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger">@message</div>
    }
    else if (joueurActif is not null)
    {
        <div class="alert alert-success">
            <strong>@joueurActif.Nom</strong> (@joueurActif.Mail) est associé à votre session.
        </div>
        <p>Score : @joueurActif.ScoreTotal</p>
        <button class="btn btn-primary" @onclick="@AllerAventure">Commencer / reprendre une aventure</button>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private Joueur? joueurActif;
    private bool loading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await AssocierJoueurConnecte();
    }

    private async Task AssocierJoueurConnecte()
    {
        loading = true;
        try
        {
            var api = ClientFactory.CreateClient("Api");
            var authState = AuthStateTask is null ? null : await AuthStateTask;
            var user = authState?.User;
            if (user == null || !user.Identity?.IsAuthenticated == true)
            {
                message = "Utilisateur non authentifié.";
                return;
            }

            var username = user.FindFirst("preferred_username")?.Value ?? user.Identity?.Name ?? "joueur";
            var email = user.FindFirst(ClaimTypes.Email)?.Value
                        ?? user.FindFirst("email")?.Value
                        ?? $"{username}@gamequest.local";

            var data = await api.GetFromJsonAsync<List<Joueur>>("api/Joueurs") ?? new();

            var existant = data.FirstOrDefault(j =>
                string.Equals(j.Mail, email, StringComparison.OrdinalIgnoreCase)
                || string.Equals(j.Nom, username, StringComparison.OrdinalIgnoreCase));

            if (existant is not null)
            {
                joueurActif = existant;
            }
            else
            {
                var response = await api.PostAsJsonAsync("api/Joueurs", new Joueur
                {
                    Nom = username,
                    Mail = email
                });
                response.EnsureSuccessStatusCode();
                joueurActif = await response.Content.ReadFromJsonAsync<Joueur>();
            }

            if (joueurActif is not null)
            {
                PlayerState.SetPlayer(joueurActif.Id, joueurActif.Nom);
            }
        }
        catch (AccessTokenNotAvailableException tokenEx)
        {
            tokenEx.Redirect();
        }
        catch (Exception ex)
        {
            message = $"Erreur association joueur : {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void AllerAventure()
    {
        Navigation.NavigateTo("/nouvelle-aventure");
    }
}
