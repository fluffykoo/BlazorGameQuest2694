@page "/joueurs"
@using BlazorGame.Domain
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BlazorGame.Client.Services.PlayerState PlayerState

<PageTitle>Choisir un joueur</PageTitle>

<div class="container mt-4">
    <h2>Choisir ou créer un joueur</h2>

    @if (loading)
    {
        <p>Chargement des joueurs...</p>
    }
    else
    {
        @if (joueurs.Count == 0)
        {
            <div class="alert alert-info">Aucun joueur. Créez-en un ci-dessous.</div>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Mail</th>
                        <th>Score</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in joueurs)
                    {
                        <tr class="align-middle">
                            <td>@j.Nom</td>
                            <td>@j.Mail</td>
                            <td>@j.ScoreTotal</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => Choisir(j)">
                                    Utiliser
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Créer un nouveau joueur</h5>
            <div class="mb-3">
                <label class="form-label">Nom</label>
                <input class="form-control" @bind="nouveauNom" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" @bind="nouveauMail" />
            </div>
            <button class="btn btn-success" @onclick="Creer">Créer et utiliser</button>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="mt-2 text-danger">@message</div>
            }
        </div>
    </div>
</div>

@code {
    private List<Joueur> joueurs = new();
    private bool loading = true;
    private string nouveauNom = string.Empty;
    private string nouveauMail = string.Empty;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await ChargerJoueurs();
    }

    private async Task ChargerJoueurs()
    {
        loading = true;
        try
        {
            var data = await Http.GetFromJsonAsync<List<Joueur>>("api/Joueurs");
            joueurs = data ?? new List<Joueur>();
        }
        catch (Exception ex)
        {
            message = $"Erreur chargement joueurs : {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void Choisir(Joueur j)
    {
        PlayerState.SetPlayer(j.Id, j.Nom);
        Navigation.NavigateTo("/nouvelle-aventure");
    }

    private async Task Creer()
    {
        message = null;
        if (string.IsNullOrWhiteSpace(nouveauNom) || string.IsNullOrWhiteSpace(nouveauMail))
        {
            message = "Nom et email sont requis.";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("api/Joueurs", new Joueur
            {
                Nom = nouveauNom.Trim(),
                Mail = nouveauMail.Trim()
            });
            response.EnsureSuccessStatusCode();

            var joueurCree = await response.Content.ReadFromJsonAsync<Joueur>();
            if (joueurCree != null)
            {
                PlayerState.SetPlayer(joueurCree.Id, joueurCree.Nom);
                Navigation.NavigateTo("/nouvelle-aventure");
            }
        }
        catch (Exception ex)
        {
            message = $"Erreur création joueur : {ex.Message}";
        }
    }
}
