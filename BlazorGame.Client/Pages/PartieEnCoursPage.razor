@page "/partie-en-cours"
@using BlazorGame.Domain
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject BlazorGame.Client.Services.PlayerState PlayerState

<h1>Partie en cours</h1>

@if (isLoading)
{
    <p>Chargement...</p>
}
else if (partieEnCours is null)
{
    <div class="alert alert-info mt-3">
        Vous n'avez pas de partie en cours.
    </div>

    <button class="btn btn-primary mt-2"
            @onclick="DemarrerNouvellePartie">
        Démarrer une nouvelle aventure
    </button>
}
else
{
    <section class="mb-4">
        <h3>@partieEnCours.Donjon?.Nom</h3>
        <p>@partieEnCours.Donjon?.Description</p>

        <p>
            Date : @partieEnCours.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />
            Score actuel : @partieEnCours.ScoreFinal pts<br />
            Salles : @nbSallesVisitees / @nbSallesTotales
        </p>

        <button class="btn btn-success"
                @onclick="() => ReprendrePartie(partieEnCours.Id)">
            Reprendre la partie
        </button>
    </section>
}

@code {
    private Partie? partieEnCours;
    private bool isLoading = true;
    private int nbSallesTotales;
    private int nbSallesVisitees;

    protected override async Task OnInitializedAsync()
    {
        if (PlayerState.CurrentJoueurId is null || PlayerState.CurrentJoueurId == Guid.Empty)
        {
            Navigation.NavigateTo("/joueurs");
            return;
        }

        try
        {
            // On récupère toutes les parties du joueur
            var api = ClientFactory.CreateClient("Api");
            var parties = await api.GetFromJsonAsync<List<Partie>>(
                $"api/Partie/joueur/{PlayerState.CurrentJoueurId}");

            if (parties is not null && parties.Any())
            {
                // On prend la dernière partie non terminée (EstTerminee = false)
                partieEnCours = parties
                    .Where(p => !p.EstTerminee)
                    .OrderByDescending(p => p.Date)
                    .FirstOrDefault();

                if (partieEnCours is not null)
                {
                    nbSallesTotales = partieEnCours.Salles?.Count ?? 0;
                    nbSallesVisitees = partieEnCours.Salles?
                        .Count(s => s.EstVisitee) ?? 0;
                }
            }
        }
        catch (AccessTokenNotAvailableException tokenEx)
        {
            tokenEx.Redirect();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ReprendrePartie(Guid partieId)
        => Navigation.NavigateTo($"/donjon/{partieId}");

    private void DemarrerNouvellePartie()
        => Navigation.NavigateTo("/nouvelle-aventure");
}
