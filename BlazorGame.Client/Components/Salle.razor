@page "/salle/{PartieId:guid}"
@using Models
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Net.Http.Json

@if (currentSalle == null)
{
    <div class="loading-screen">
        <h3>Chargement de la salle...</h3>
        <p>@messageResultat</p>
    </div>
}
else
{
    <div class="dungeon-room">
        <div class="room-header">
            <h3>Salle @currentSalle.Position - Le Donjon</h3>
            <div class="room-difficulty">
                <span class="difficulty-badge difficulty-@currentSalle.Niveau.ToString().ToLower()">
                    Difficulté: @currentSalle.Niveau
                </span>
            </div>
        </div>
        
        <div class="room-description">
            <p>@currentSalle.Description</p>
        </div>

        @if (currentSalle.Resultat != null)
        {
            var res = currentSalle.Resultat;

            <div class="result-container @(res.EstPiege ? "result-danger" : "result-success")">
                <h4>@res.Message</h4>

                <div class="result-details">
                    <p><strong>Action :</strong> @res.Action</p>

                    @if (res.Points > 0)
                    {
                        <p class="points-won">+@res.Points pts</p>
                    }
                    @if (res.Points < 0)
                    {
                        <p class="points-lost">@res.Points pts</p>
                    }

                    <p><strong>Risque :</strong> @res.Risque %</p>
                    <p><strong>Score total :</strong> @res.ScoreTotal pts</p>
                </div>
            </div>
        }
        
        <div class="enemy-display">
            <img src="images/@(currentSalle.ImageMonstre ?? "default.png")" 
                 alt="@currentSalle.NomMonstre" class="enemy-image" />
            <div class="enemy-stats">
                <span>Ennemi : @currentSalle.NomMonstre</span>
                <span>PV : @currentSalle.PvMonstre</span>
                <span>Force: @currentSalle.ForceMonstre</span>
            </div>
        </div>
        
        <div class="action-choices">
            <h4>Que choisissez-vous ?</h4>
            
            @if (actionFaite)
            {
                <div class="action-buttons">
                    <button class="btn-action btn-next" @onclick="SalleSuivante">
                        @if (currentSalle.Position >= totalSalles && totalSalles > 0)
                        {
                            <span>Finir l'Aventure !</span>
                        }
                        else
                        {
                            <span>Salle suivante >></span>
                        }
                    </button>

                    <button class="btn-action btn-flee" @onclick="RetourAuDonjon">
                        Revenir au donjon
                    </button>
                </div>
            }
            else
            {
                <div class="action-buttons">
                    <button class="btn-action btn-combat" disabled="@actionFaite"
                            @onclick="@(() => ExecuterAction(ChoixAction.Combattre))">
                        Combattre
                    </button>
                    <button class="btn-action btn-flee" disabled="@actionFaite"
                            @onclick="@(() => ExecuterAction(ChoixAction.Fuir))">
                        Fuir
                    </button>
                    <button class="btn-action btn-search" disabled="@actionFaite"
                            @onclick="@(() => ExecuterAction(ChoixAction.Fouiller))">
                        Fouiller
                    </button>
                </div>
            }
        </div>
        
        <div class="room-progress">
            @{
                double progress = totalSalles == 0
                    ? 0
                    : currentSalle.Position / (double)totalSalles * 100;
            }
            <div class="progress-bar">
                <div class="progress-fill" style="width: @progress%"></div>
            </div>
            <span>Progression: @currentSalle.Position / @totalSalles salles</span>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid PartieId { get; set; }

    private Models.Salle? currentSalle;
    private string messageResultat = "Initialisation...";
    private bool actionFaite => currentSalle?.ChoixFait.HasValue ?? false;

    private int totalSalles = 0;

    protected override async Task OnInitializedAsync()
    {
        await ChargerSalleActuelle();
    }

    private async Task ChargerSalleActuelle()
    {
        currentSalle = null;
        messageResultat = "Chargement de la partie et recherche de la salle actuelle...";

        try
        {
            var partie = await Http.GetFromJsonAsync<Partie>($"api/Partie/{PartieId}");

            if (partie == null)
            {
                messageResultat = "Erreur: Partie introuvable ou API non disponible.";
                return;
            }

            totalSalles = partie.Salles?.Count ?? 0;

            currentSalle = partie.Salles
                .OrderBy(s => s.Position)
                .FirstOrDefault(s => s.EstVisitee == false);

            if (currentSalle == null)
            {
                messageResultat = "Félicitations ! L'aventure est terminée.";
                if (partie.EstTerminee)
                {
                    Navigation.NavigateTo($"/score/{PartieId}");
                }
            }
            else if (actionFaite)
            {
                messageResultat = "Cette salle a déjà été résolue.";
            }
            else
            {
                messageResultat = string.Empty;
            }
        }
        catch (Exception ex)
        {
            messageResultat = $"Erreur de connexion à l'API: {ex.Message}";
        }
    }

    private async Task ExecuterAction(ChoixAction action)
    {
        if (actionFaite || currentSalle == null) return;

        try
        {
            var response = await Http.PatchAsJsonAsync($"api/Salle/{currentSalle.Id}/action", action);
            response.EnsureSuccessStatusCode();

            currentSalle.Resultat = await response.Content.ReadFromJsonAsync<ActionResultat>();
            currentSalle.ChoixFait = action;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            messageResultat = $"Erreur lors de l'exécution de l'action: {ex.Message}";
        }
    }

    private void SalleSuivante()
    {
        Navigation.NavigateTo($"/salle/{PartieId}", forceLoad: true);
    }

    private void RetourAuDonjon()
    {
        Navigation.NavigateTo($"/donjon/{PartieId}");
    }
}

<style>
    .room-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #d4af37;
        padding-bottom: 1rem;
    }

    .room-header h3 {
        color: #ffd700;
        margin: 0;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    }

    .difficulty-badge {
        padding: 0.3rem 1rem;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .difficulty-facile {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }
    
    .difficulty-moyen {
        background: linear-gradient(135deg, #d4af37, #b8860b);
        color: #1a0f0f;
    }
    
    .difficulty-difficile {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: white;
    }

    .room-description {
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
        text-align: center;
        font-style: italic;
    }

    .enemy-display {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2rem;
        margin: 2rem 0;
        padding: 1.5rem;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 10px;
        border: 1px solid #8b4513;
    }

    .enemy-image {
        width: 120px;
        height: 120px;
        object-fit: contain;
        filter: drop-shadow(0 0 10px rgba(255, 0, 0, 0.3));
    }

    .enemy-stats {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 1.1rem;
    }

    .action-choices {
        text-align: center;
        margin: 2rem 0;
    }

    .action-choices h4 {
        color: #ffd700;
        margin-bottom: 1.5rem;
        font-size: 1.3rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .btn-next {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        color: white;
        border: 2px solid #1d4ed8;
    }

    .btn-action {
        padding: 1rem 2rem;
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 150px;
        font-family: 'MedievalSharp', cursive;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    }

    .btn-combat {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
        border: 2px solid #8b0000;
    }

    .btn-combat:hover:not(:disabled) {
        background: linear-gradient(135deg, #c82333, #a71e2a);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
    }

    .btn-flee {
        background: linear-gradient(135deg, #ffc107, #e0a800);
        color: #1a0f0f;
        border: 2px solid #b8860b;
    }

    .btn-flee:hover:not(:disabled) {
        background: linear-gradient(135deg, #e0a800, #d39e00);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4);
    }

    .btn-search {
        background: linear-gradient(135deg, #28a745, #218838);
        color: white;
        border: 2px solid #155724;
    }

    .btn-search:hover:not(:disabled) {
        background: linear-gradient(135deg, #218838, #1e7e34);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
    }
    
    .btn-action:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        box-shadow: none;
    }

    .room-progress {
        margin-top: 2rem;
        text-align: center;
    }

    .progress-bar {
        width: 100%;
        height: 20px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 10px;
        border: 1px solid #8b4513;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #d4af37, #ffd700);
        border-radius: 10px;
        transition: width 0.5s ease;
    }

    .result-container {
        padding: 1.5rem;
        margin: 1rem auto;
        max-width: 500px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.4);
        font-family: 'MedievalSharp', cursive;
    }

    .result-success {
        background: rgba(40, 167, 69, 0.15);
        border: 2px solid #28a745;
        color: #d4ffd9;
    }

    .result-danger {
        background: rgba(220, 53, 69, 0.15);
        border: 2px solid #dc3545;
        color: #ffd4d4;
    }

    .result-details p {
        margin: 0.3rem 0;
        font-size: 1.1rem;
    }

    .points-won {
        color: #7CFF7C;
        font-weight: bold;
        font-size: 1.3rem;
    }

    .points-lost {
        color: #FF6161;
        font-weight: bold;
        font-size: 1.3rem;
    }
</style>